server {
    location /api {
        set $backend_container "backend";
        proxy_pass http://$backend_container:8000;
        proxy_connect_timeout 240s;
        proxy_read_timeout 240s;
        proxy_send_timeout 240s;
        send_timeout 240s;
    }
    location / {
        root /data/static;
        try_files $uri /index.html;
    }
}
